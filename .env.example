# Все настройки опциональные, ниже представлены рекомендуемые дефолтные настройки

# =====================================================================
# 1. Модель
# =====================================================================

# Бэкенд из реестра: fake отвечает без весов и видеокарты; настоящие модели задаются в развёртывании
MODEL_BACKEND=fake
# Модель бэкенда; если не задана - модель бэкенда по умолчанию
MODEL_NAME=
TARGET_PLATFORM=cpu         # cuda - на машине с видеокартой (образ из Dockerfile)
# Локальные веса (в compose каталог ./model монтируется в /opt/model); если не заданы - веса скачиваются в кэш
ARTIFACTS_PATH=
FAKE_LATENCY_MS=0           # время инференса, которое изображает бэкенд fake, мс на вызов

# =====================================================================
# 2. Сервис
# =====================================================================

# Bearer-токен для /v1/*; если не задан, аутентификация выключена. В развёртывании задавайте всегда
AUTH_TOKEN=
WORKERS=1                   # потоков инференса: сколько запросов обрабатывается одновременно
QUEUE_MAX=4                 # сколько запросов ждут свободный поток; следующие сразу получают 503
# GIT_SHA задаёт аргумент сборки образа: в .env его не пишут, иначе /v1/info покажет не тот коммит

# =====================================================================
# 3. Логирование
# =====================================================================

LOG_LEVEL=INFO
LOG_DIAGNOSE=False          # значения переменных в трейсбеках; только для отладки - в логи попадут данные запросов и токены
